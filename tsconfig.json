{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"ES2022"
		],
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"declaration": true,
		"sourceMap": true,
		"types": [
			"bun-types",
			"node"
		]
	},
	"include": [
		"src"
	],
	"exclude": [
		"src/**/*.test.ts",
		"dist",
		"node_modules"
	]
}